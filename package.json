{
  "name": "lazycad",
  "version": "1.0.0",
  "description": "LazyCAD \u2014 parametric, constraint-based 3D CAD in the browser that Claude can drive as a skill",
  "author": "haroonalisa",
  "homepage": "https://github.com/haroonalisa/lazyCAD#readme",
  "repository": {
    "type": "git",
